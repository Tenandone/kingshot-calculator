{
  "name": "kingshot-calculator",
  "version": "1.0.0",
  "description": "Kingshot training & promotion calculator",
  "main": "bump-version.js",
  "scripts": {
    "dev": "vite dev",
    "generate:routes": "node scripts/generate-static-routes.js",
    "prebuild": "npm run sitemap",
    "build": "vite build",
    "sitemap": "node scripts/apply-lootbar-state.js --restore && npm run generate:routes && node scripts/prepare-publishing.js && node scripts/apply-lootbar-state.js && node scripts/generate-sitemap.js && node scripts/generate-catalog.js && node scripts/generate-image-manifest.js",
    "coupons:update": "node scripts/coupons/update-coupons.js --write",
    "coupons:check": "node scripts/coupons/update-coupons.js",
    "coupons:test": "node scripts/coupons/test-coupons.js",
    "audit:seo": "node scripts/audit-static-seo.js",
    "bump": "node bump-version.js",
    "deploy": "node -e \"console.error('Publish reviewed commits to main; GitHub Pages serves the repository root, not dist.');process.exit(1)\"",
    "audit:publishing": "node scripts/audit-publishing.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tenandone/kingshot-calculator.git"
  },
  "keywords": [],
  "author": "Ten",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Tenandone/kingshot-calculator/issues"
  },
  "homepage": "https://tenandone.github.io/kingshot-calculator/",
  "devDependencies": {
    "image-size": "^2.0.4",
    "parse5": "^8.0.1",
    "vite": "^7.3.1"
  }
}
