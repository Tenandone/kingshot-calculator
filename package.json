{
  "name": "kingshot-calculator",
  "version": "1.0.0",
  "description": "Kingshot training & promotion calculator",
  "main": "bump-version.js",
  "scripts": {
    "dev": "vite dev",
    "generate:routes": "node scripts/generate-static-routes.js",
    "prebuild": "npm run sitemap",
    "build": "vite build",
    "sitemap": "npm run generate:routes && node scripts/generate-sitemap.js",
    "coupons:update": "node scripts/coupons/update-coupons.js --write",
    "coupons:check": "node scripts/coupons/update-coupons.js",
    "coupons:test": "node scripts/coupons/test-coupons.js",
    "audit:seo": "node scripts/audit-static-seo.js",
    "bump": "node bump-version.js",
    "deploy": "npm run bump && npm run build && gh-pages -d dist"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tenandone/kingshot-calculator.git"
  },
  "keywords": [],
  "author": "Ten",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Tenandone/kingshot-calculator/issues"
  },
  "homepage": "https://tenandone.github.io/kingshot-calculator/",
  "devDependencies": {
    "gh-pages": "^6.3.0",
    "vite": "^7.3.1"
  }
}
